<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>DesktopPet</RootNamespace>
    <AssemblyName>eSheep</AssemblyName>
    <ApplicationIcon>esheep.png.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <Platforms>x86;x64;AnyCPU</Platforms>
    <Version>2.2.6.0</Version>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\build\DesktopPet\bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\build\DesktopPet\bin\Release\$(Platform)\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>..\build\DesktopPet\bin\Release\eSheep.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="LocalData\LocalData.csproj" />
  </ItemGroup>

  <!-- Exclude folders that should not be compiled -->
  <ItemGroup>
    <Compile Remove="dotNet\Portable\**" />
    <Compile Remove="Portable\**" />
    <Compile Remove="UWPSheep\**" />
    <Compile Remove="AppWins\**" />
    <Compile Remove="LocalData\**" />
    <Compile Remove="Properties\AssemblyInfoPortable.cs" />
    <Compile Remove="Properties\Settings1.Designer.cs" />
    <EmbeddedResource Remove="dotNet\Portable\**" />
    <EmbeddedResource Remove="Portable\**" />
    <EmbeddedResource Remove="UWPSheep\**" />
    <EmbeddedResource Remove="AppWins\**" />
    <None Remove="dotNet\Portable\**" />
    <None Remove="Portable\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="dotNet\FormPet.resx">
      <DependentUpon>FormPet.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="dotNet\FormDebug.resx">
      <DependentUpon>FormDebug.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="esheep.png.ico" />
    <Content Include="icon.ico" />
    <Content Include="Images\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="Resources\animations.xml" />
    <None Include="Resources\animations.xsd" />
  </ItemGroup>

</Project>
